{
  "name": "imagecraft",
  "version": "1.3.9",
  "description": "A WordPress plugin that generates alt text for images using AI.",
  "main": "resources/admin/main.js",
  "scripts": {
    "dev": "touch .dev && node resources/env.config.js && vite",
    "prod": "rm -f .dev && node resources/env.config.js --prod && vite build",
    "serve": "vite preview",
    "lint": "eslint resources/",
    "lint:fix": "eslint resources/ --fix",
    "validate": "npm run lint && npm run prod",
    "prepare": "husky"
  },
  "lint-staged": {
    "resources/**/*.{js,vue}": [
      "eslint --max-warnings=0"
    ]
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.2.2",
    "@tiptap/starter-kit": "^2.2.4",
    "@tiptap/vue-3": "^2.2.4",
    "echarts": "^6.0.0",
    "lucide-vue-next": "^0.344.0",
    "sass": "^1.99.0",
    "vue": "^3.5.32",
    "vue-router": "^5.0.4"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.5",
    "eslint": "^10.2.0",
    "eslint-plugin-vue": "^10.8.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "vite": "^8.0.8",
    "vite-plugin-live-reload": "^3.1.0",
    "vue-eslint-parser": "^10.4.0"
  },
  "keywords": [
    "wordpress",
    "plugin",
    "vue",
    "tailwind",
    "vite"
  ],
  "author": "Your Name",
  "license": "MIT",
  "type": "module"
}
