#. Plugin Name of the plugin
#: imagecraft-ai-alt-text-file-renamer-image-seo.php
msgid "ImageCraft - AI Alt Text, Image Compression & WebP"
msgstr "ImageCraft - Texte alternatif IA, compression d'images & WebP"

#. Plugin URI of the plugin
#: imagecraft-ai-alt-text-file-renamer-image-seo.php
msgid ""
"https://www.softminal.com/products/imagecraft-ai-alt-text-file-renamer-image-"
"seo"
msgstr "https://www.softminal.com/products/imagecraft-ai-alt-text-file-renamer-image-seo"

#. Description of the plugin
#: imagecraft-ai-alt-text-file-renamer-image-seo.php
msgid ""
"All-in-one image toolkit: AI-powered alt text & titles, smart image "
"compression, SEO file renaming, and image SEO audit. Supports WordPress 7.0 "
"native AI Client, Anthropic, OpenAI and Gemini."
msgstr "Boîte à outils d'images tout-en-un : textes alternatifs et titres générés par IA, compression intelligente des images, renommage SEO des fichiers et audit SEO des images. Compatible avec l'AI Client natif de WordPress 7.0, Anthropic, OpenAI et Gemini."

#. Author of the plugin
#: imagecraft-ai-alt-text-file-renamer-image-seo.php
msgid "Softminal"
msgstr "Softminal"

#. Author URI of the plugin
#: imagecraft-ai-alt-text-file-renamer-image-seo.php
msgid "https://softminal.com"
msgstr "https://softminal.com"

#: includes/AdminNotice.php:63
msgid "New in ImageCraft: Image Fallbacks — never show a broken image again."
msgstr "Nouveau dans ImageCraft : images de secours — ne montrez plus jamais une image cassée."

#: includes/AdminNotice.php:64
msgid ""
"Pick one fallback image: it replaces broken images for your visitors and "
"acts as the featured image for posts without one. Non-destructive and off by "
"default."
msgstr "Choisissez une image de secours : elle remplace les images cassées pour vos visiteurs et sert d'image mise en avant aux articles qui n'en ont pas. Non destructif et désactivé par défaut."

#: includes/AdminNotice.php:68
msgid "Set up Image Fallbacks"
msgstr "Configurer les images de secours"

